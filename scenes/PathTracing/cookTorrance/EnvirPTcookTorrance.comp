// fast

vec3 getBlueNoise(vec2 uv, float bounce) {
	// get exact px coord across screen space bounds
	// wrap coordinates around
	ivec2 pixelCoord = ivec2(mod((uv * u_resolution),(u_blueNoiseSize.xy)));
	
	// animate through depth slices each frame
	int zSlice = int(mod(u_frame+bounce,(u_blueNoiseSize.z)));
	
	// use texelFetch for raw data to avoid float lerp
	vec3 baseNoise = texelFetch(u_blueNoiseTex, ivec3(pixelCoord, zSlice), 0).rgb;
	
	// distribute noise cleanly per bounce using Golden Ratio fractional
	float seed = float(u_frame) + float(bounce) * 13.123;
	
	vec3 offset = seed * vec3(
		0.6180339887498949, // Golden Ratio
		0.2469796037174670, // Plastic Constant / Silver Ratio variant
		0.1591549430918953	// 1/2pi variant
	);
	
	return fract(baseNoise + offset);
}

// Uniformly maps a 3D blue noise sample to a unit sphere
vec3 random_on_unit_sphere(vec3 blueNoise) {
	float theta = blueNoise.x * 6.28318530718;
	float cosPhi = blueNoise.y * 2.0 - 1.0;
	float sinPhi = alu_sqrt(1.0 - cosPhi * cosPhi);

	return vec3(
		sinPhi * cos(theta),
		sinPhi * sin(theta),
		cosPhi
	);
}

struct Ray {
	vec3 o;
	vec3 d;
};


vec2 sphIntersect( in vec3 ro, in vec3 rd, float ra ) {
	float b	= dot( ro, rd );
	float c	= dot( ro, ro )	- ra*ra;
	float h	= b*b -	c;
	if(	h<0.0 )	return vec2(-1.0); // no intersection
	h =	sqrt( h	);
	return vec2( -b-h, -b+h	);
}

