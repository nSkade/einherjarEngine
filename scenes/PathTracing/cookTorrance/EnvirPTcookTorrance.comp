vec3 getNormal(float hitTriIdx) {
	uint triIdx = floatBitsToUint(hitTriIdx);
	uint v0 = triIdx * 3;
	vec3 edge1 = triData.tri[v0 + 1].p.xyz - triData.tri[v0].p.xyz;
	vec3 edge2 = triData.tri[v0 + 2].p.xyz - triData.tri[v0].p.xyz;

	return alu_normalize(cross(edge1.xyz, edge2.xyz));
}

vec3 getNormal(uint triIdx) {
	uint v0 = triIdx * 3;
	vec3 edge1 = triData.tri[v0 + 1].p.xyz - triData.tri[v0].p.xyz;
	vec3 edge2 = triData.tri[v0 + 2].p.xyz - triData.tri[v0].p.xyz;

	return alu_normalize(cross(edge1.xyz, edge2.xyz));
}

vec2 getUVlerp(uint triIdx, vec2 uv) {
	uint v0 = triIdx * 3u;
	vec2 uv0 = getUV(v0);
	vec2 uv1 = getUV(v0 + 1u);
	vec2 uv2 = getUV(v0 + 2u);

	float w = 1.0 - uv.x - uv.y;
	vec2 interpolatedUV = (uv0 * w) + (uv1 * uv.x) + (uv2 * uv.y);

	return interpolatedUV;
}

vec3 getTANlerp(uint triIdx, vec2 uv) {
	uint v0 = triIdx * 3u;
	vec3 tan0 = getTAN(v0);
	vec3 tan1 = getTAN(v0 + 1u);
	vec3 tan2 = getTAN(v0 + 2u);

	float w = 1.0 - uv.x - uv.y;
	vec3 interpolatedTAN = (tan0 * w) + (tan1 * uv.x) + (tan2 * uv.y);

	return interpolatedTAN;
}

float hash3(vec3 p) {
	p = fract(p * vec3(443.8975, 441.4230, 437.1951));
	p += dot(p, p.yzx + 19.19);
	return fract((p.x + p.y) * p.z);
}

vec3 random_in_unit_sphere(vec3 seed) {
	float h1 = hash3(seed);
	float h2 = hash3(seed + 1.0);
	float h3 = hash3(seed + 2.0);
	vec3 p = vec3(h1, h2, h3) * 2.0 - 1.0;
	return normalize(p);
}

