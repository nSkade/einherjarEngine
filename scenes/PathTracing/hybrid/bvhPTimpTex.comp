		color = vec4(hit.y,hit.z,0.,1.);

		vec3 n = getNormal(hit.w);
		color = vec4(n,1.);
	}
	// single shadow bounce
	//if (hit.x < 1e30f) {	// bounce
	//	vec3 hitPos = hit.x * camdir + campos + n *0.1;
	//	vec3 sunPos = vec3(0.,10.+sin(u_time)*9.,0.)*100.;
	//	vec3 sunDir = normalize(sunPos-hitPos);

	//	color = vec4(vec3(dot(n,sunDir)),1.);

	//	vec4 hit2 = traverse_ailalaine( hitPos, sunDir, vec3(1.)/sunDir, 1e30f );
	//	if (hit2.x < length(sunPos-hitPos))
	//		color.xyz *= 0.;
	//}
#endif

#if 0 // single
	{
		Ray r;
		r.o=campos;
		r.d=camdir;
		//color = vec4(shade(r,1,uv),1.);
		color.xyz = vec3(0.);
		for (int i=0;i<3;++i)
			color.xyz += shade(r,i,uv);
		color = vec4(color.xyz,1.)*.1 + .9*texture(u_p,uv);
	}
#endif

#if 1 // accumulate
	int samples = 1;
	vec3 c = vec3(0.);
	Ray r;
	r.o=campos;
	r.d=camdir;
	float _;
	for (int i=0;i<samples;++i)
		c += shade(r,i,uv,_);
	c /= samples;
	//color.rgb = c;

	if (u_frame==0)
		color = vec4(c,1.);
	else {
		if (u_camChange == 0.) {
			color = vec4(c,1.) + texture(u_p,uv); // more stable for offline rendering
			//float w = 1./(1.+u_frame);
			//color = vec4(c,1.)*w + (1.-w)*texture(u_p,uv);

			color.a = 1.;
		}
		else 
			color = vec4(c,1.)*.5+.5*texture(u_p,uv);
	}
#endif

	imageStore(u_outImg,texelCoord,color);
}
