vec3 alu_normalize(vec3 v) {
	float dot_product = dot(v, v);
	
	// Fallback check to prevent division-by-zero on completely empty vectors
	//if (dot_product < 0.000000001) return vec3(0.0); 
	
	// 0x5f3759df Fast Inverse Square Root
	float xhalf = 0.5 * dot_product;
	int i = floatBitsToInt(dot_product);
	i = 0x5f3759df - (i >> 1); 
	float f = intBitsToFloat(i);
	f = f * (1.5 - xhalf * f * f); // Precision pass
	
	return v * f;
}

